# ───────────── Frontend (shipped to the browser — public values only) ─────────────
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# ───────────── Server only (set in Netlify → Site configuration → Environment variables; no VITE_ prefix) ─────────────
CLERK_SECRET_KEY=your_clerk_secret_key
# Comma-separated Clerk user IDs allowed into /admin (Clerk dashboard → Users). Empty = nobody.
ADMIN_USER_IDS=your_clerk_user_id
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB=portfolio
GROQ_API_KEY=your_groq_api_key
# Your public site URL (used for the origin allow-list)
SITE_URL=https://mehedy.netlify.app
